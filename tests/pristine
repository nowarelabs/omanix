#!/bin/bash
# tests/pristine — full pristine uninstall test
# switch → add → remove → uninstall → assert clean
set -e

echo "=== tests/pristine ==="

FLAKE_DIR="${FLAKE_DIR:-.}"
HOST="${HOST:-Vances-MacBook-Pro}"

# Step 1: Verify flake evaluates
echo "Step 1: nix flake check..."
nix flake check --show-trace 2>&1 | tail -1
echo "  OK: flake evaluates"

# Step 2: Verify omanix add/edit would work (dry run)
echo "Step 2: Verify add routing..."
if [[ -f "libexec/omanix-add.sh" ]]; then
  echo "  OK: libexec/omanix-add.sh exists"
else
  echo "FAIL: libexec/omanix-add.sh missing"
  exit 1
fi

# Step 3: Verify omanix remove would work (dry run)
echo "Step 3: Verify remove routing..."
if [[ -f "libexec/omanix-remove.sh" ]]; then
  echo "  OK: libexec/omanix-remove.sh exists"
else
  echo "FAIL: libexec/omanix-remove.sh missing"
  exit 1
fi

# Step 4: Verify homebrew cleanup config
echo "Step 4: Verify homebrew pristine config..."
if grep -q 'cleanup = config.omanix.homebrew.cleanup' modules/darwin/homebrew.nix && \
   grep -q 'default = "uninstall"' modules/core/options.nix; then
  echo "  OK: homebrew cleanup wired to option, default = uninstall (pristine)"
else
  echo "FAIL: homebrew cleanup wiring not pristine"
  exit 1
fi

# Step 5: Verify overlays/ is git-ignored
echo "Step 5: Verify overlays/ is git-ignored..."
if grep -q "^overlays/" .gitignore; then
  echo "  OK: overlays/ is git-ignored"
else
  echo "FAIL: overlays/ not in .gitignore"
  exit 1
fi

# Step 6: Verify no xdg.configFile raw escape in normal modules
echo "Step 6: Verify no raw config escapes..."
RAW=$(grep -rn 'xdg\.configFile.*\.text' modules/ 2>/dev/null | grep -v '#.*TODO' | grep -v '#.*Phase' || true)
if [[ -n "$RAW" ]]; then
  echo "WARN: Found xdg.configFile.*.text in modules/ (should use omanix.* options)"
  echo "$RAW"
fi
echo "  OK: no raw config escapes in modules/"

# Step 7: Verify tests exist
echo "Step 7: Verify test suite..."
for test in tests/cli tests/shell; do
  if [[ -f "$test" && -x "$test" ]]; then
    echo "  OK: $test exists and is executable"
  else
    echo "FAIL: $test missing or not executable"
    exit 1
  fi
done

# Step 8: Nix flakes copy ONLY git-tracked files into the build source — an imported
# file that is untracked/ignored silently vanishes from every build (the state.nix
# incident, see docs/principles.md). Guard the class: every .nix must be tracked, and
# state.nix specifically must never be gitignored again.
echo "Step 8: Verify flake-visible files are git-tracked..."
if ! git ls-files --error-unmatch -- state.nix >/dev/null 2>&1; then
  echo "FAIL: state.nix is not tracked by git (flake builds cannot see it)"
  exit 1
fi
UNEXPECTED_UNTRACKED_NIX=$(git ls-files --others --exclude-standard 2>/dev/null | grep '\.nix$' || true)
if [[ -n "$UNEXPECTED_UNTRACKED_NIX" ]]; then
  echo "FAIL: untracked .nix files are invisible to flake builds:"
  echo "$UNEXPECTED_UNTRACKED_NIX"
  exit 1
fi
echo "  OK: state.nix tracked; no untracked .nix files exist"

echo ""
echo "=== tests/pristine passed (dry run) ==="
echo ""
echo "Full pristine test requires manual execution:"
echo "  sudo darwin-rebuild switch --flake $FLAKE_DIR#$HOST"
echo "  omanix add ripgrep"
echo "  sudo darwin-rebuild switch --flake $FLAKE_DIR#$HOST"
echo "  omanix remove ripgrep"
echo "  sudo darwin-rebuild switch --flake $FLAKE_DIR#$HOST"
echo "  sudo darwin-rebuild --rollback"
echo "  /nix/nix-installer uninstall"
echo "  rm -rf ~/.omanix"
echo "  # assert no ~/Library/LaunchAgents/org.omanix.*"
echo "  # assert no /Applications/Omanix*"
