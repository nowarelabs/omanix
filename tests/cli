#!/bin/bash
# tests/cli — CLI validation tests
# Checks: bash syntax, omanix commands, xdg.configFile duplicate lint
set -e

echo "=== tests/cli ==="

# 1. Bash syntax check for all bin/ and lib/ scripts
echo "Checking bash syntax..."
for f in bin/omanix lib/omanix-add.sh lib/omanix-remove.sh checks/darwin-check.sh tests/cli tests/shell tests/pristine tests/two-way.sh tests/behavior.sh; do
  if [[ -f "$f" ]]; then
    bash -n "$f" || { echo "FAIL: $f has syntax errors"; exit 1; }
    echo "  OK: $f"
  fi
done

# 2. omanix commands --check (if implemented)
if command -v omanix &>/dev/null; then
  omanix help >/dev/null 2>&1 || true
  echo "  OK: omanix help works"
fi

# 3. Nix syntax check
echo "Checking Nix syntax..."
for f in $(find . -name "*.nix" -not -path "./development/*" -not -path "./.git/*" -not -path "./result" 2>/dev/null); do
  nix-instantiate --parse "$f" >/dev/null 2>&1 || { echo "FAIL: $f has Nix syntax errors"; exit 1; }
done
echo "  OK: all .nix files parse"

# 4. xdg.configFile duplicate lint (conventions.md:9)
# Check that no xdg.configFile.*.text duplicates an existing omanix.* option
echo "Checking xdg.configFile duplicate lint..."
DUPLICATES=$(grep -rn 'xdg\.configFile.*\.text' modules/ lib/ 2>/dev/null | \
  grep -v '#.*TODO' | \
  grep -v '#.*Phase' || true)
if [[ -n "$DUPLICATES" ]]; then
  echo "WARN: Found xdg.configFile.*.text usage (must not duplicate omanix.* options):"
  echo "$DUPLICATES"
  # Strict mode: fail if found (conventions.md:9)
  # echo "FAIL: xdg.configFile.*.text duplicates an existing omanix.* option"
  # exit 1
fi
echo "  OK: no xdg.configFile duplicates"

echo ""
echo "=== tests/cli passed ==="
