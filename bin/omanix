#!/bin/bash
# bin/omanix — the one command for Omanix
# Routes to libexec/ scripts
set -e

FLAKE_DIR="${FLAKE_DIR:-$HOME/.omanix}"
HOST="${HOST:-$(scutil --get LocalHostName 2>/dev/null || echo "")}"

if [[ -f "$FLAKE_DIR/libexec/log.sh" ]]; then
  source "$FLAKE_DIR/libexec/log.sh"
  mkdir -p "$FLAKE_DIR/logs"
  log_rotate
else
  log_debug() { :; }
  log_info()  { :; }
  log_warn()  { :; }
  log_error() { :; }
fi

usage() {
  cat <<EOF
Usage: omanix <command> [options]

Commands:
  install              Install Omanix on this Mac (clones flake, prompts host/user)
  update               Update Omanix to latest version (smart merge, preserves config)
  update --version X   Pin to specific version tag
  update --commit X    Pin to specific commit
  upgrade              Update flake inputs (nix flake update + rebuild)
  rebuild              Rebuild system (darwin-rebuild switch)
  rebuild --rollback   Undo last build
  rebuild --preview    Build impure overlay preview (no generation)
  generations          List previous system generations
  clean                Clean old nix generations (keeps last 5)
  clean --dry-run      Preview what would be deleted
  clean --aggressive   Thorough cleaning (GC store + optimise)
  add <pkg>            Add package (routes nixpkgs → brew)
  remove <pkg>         Remove package
  search <pkg>         Search nixpkgs + brew
  install-app <name>   Install a custom app
  uninstall-app <name> Uninstall a custom app
  list-apps            List installed custom apps
  list-packages        List all declared packages (JSON)
  theme list           List available themes
  theme set <name>     Set theme (edits configuration.nix)
  theme preview <name> Preview theme (impure, no generation)
  theme new <name>     Scaffold new theme (community)
  theme per-app <app> <key> <val>  Per-app color override
  open                 Open Omanix app
  ask <prompt>         Ask AI (frontier Claude)
  ask --local <prompt> Ask AI (local Qwen, offline)
  version              Print version
  help                 Show this help
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  install)
    source "$FLAKE_DIR/libexec/install.sh"
    install
    ;;
  update)           exec "$FLAKE_DIR/libexec/omanix-update.sh" "$@" ;;
  upgrade)          exec "$FLAKE_DIR/libexec/omanix-upgrade.sh" "$@" ;;
  rebuild)          exec "$FLAKE_DIR/libexec/omanix-rebuild.sh" "$@" ;;
  generations)      exec "$FLAKE_DIR/libexec/omanix-generations.sh" "$@" ;;
  clean)            exec "$FLAKE_DIR/libexec/omanix-clean.sh" "$@" ;;
  add)              exec "$FLAKE_DIR/libexec/omanix-add.sh" "$@" ;;
  remove)           exec "$FLAKE_DIR/libexec/omanix-remove.sh" "$@" ;;
  search)           exec "$FLAKE_DIR/libexec/omanix-search.sh" "$@" ;;
  theme)            exec "$FLAKE_DIR/libexec/omanix-theme.sh" "$@" ;;
  install-app)      exec "$FLAKE_DIR/libexec/omanix-install-app.sh" "$@" ;;
  uninstall-app)    exec "$FLAKE_DIR/libexec/omanix-uninstall-app.sh" "$@" ;;
  list-apps)        exec "$FLAKE_DIR/libexec/omanix-list-apps.sh" "$@" ;;
  list-packages)    exec "$FLAKE_DIR/libexec/omanix-list-packages.sh" "$@" ;;
  open)             exec "$FLAKE_DIR/libexec/omanix-open.sh" "$@" ;;
  ask)              exec "$FLAKE_DIR/libexec/omanix-ask.sh" "$@" ;;
  version)          exec "$FLAKE_DIR/libexec/omanix-version.sh" "$@" ;;
  help|--help|-h|"") usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
